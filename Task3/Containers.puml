@startuml Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(client, "Клиент банка")
Person(backEmployee, "Сотрудник бэк-офиса")

Container(website, "Сайт")

System_Boundary(internetBankSystem, "Интернет-банк"){
    Container(internetBankFrontend, "Фронтэнд")
    Container(internetBank, "Бэкенд", "ASP.NET MVC 4.5")
    ContainerDb(internetBankDb, "База данных", "MS SQL")
}

System_Boundary(absSystem, "АБС"){
    Container(abs, "Клиент", "Deplhi")
    Container(absMQIntegration, "Интеграция с брокером сообщений", ".NET")
    ContainerDb(absDb, "База данных", "Oracle")
}

System_Boundary(depositSystem, "Система для работы с депозитами"){
    Container(depositServiceFrontend, "Фронтенд для сотрудников")
    Container(depositService, "Сервис для работы с депозитами", ".NET")
    ContainerDb(depositServiceDb, "База данных", "PostgreSQL")
}

Container(smsGateway, "СМС-шлюз телеком-оператора")
Container(messageBroker, "Система обмена сообщениями", "Kafka")

Container_Ext(telecomOperator, "Телеком-оператор")

Rel(client, internetBankFrontend, "Использует")
Rel(client, website, "Использует")

Rel(backEmployee, depositServiceFrontend, "Использует")
Rel(backEmployee, abs, "Использует")

Rel(internetBank, depositService, "Взаимодействует с")
Rel(website, depositService, "Взаимодействует с")

Rel(depositService, smsGateway, "Передает данные в")
Rel(depositService, messageBroker, "Взаимодействует с")
Rel(depositService, depositServiceDb, "Использует")
Rel(depositServiceFrontend, depositService, "Использует")

Rel_R(smsGateway, telecomOperator, "Передает данные в")
Rel_R(telecomOperator, client, "Взаимодействует с")

Rel(internetBankFrontend, internetBank, "Использует")
Rel(internetBank, internetBankDb, "Использует")

Rel(abs, absDb, "Использует")
Rel(absMQIntegration, messageBroker, "Взаимодействует с")
Rel(absMQIntegration, absDb, "Использует")

LAYOUT_TOP_DOWN()

@enduml

